---
/**
 * Real Astro site route for posts — default preview target (ADR-0013).
 * Cover via Astro `<Image>` (schema `image()`); author via `getEntry` on `reference()`.
 */
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
	const posts = await getCollection("posts");
	return posts.map((post) => ({
		params: { id: post.id },
	}));
}

const { id } = Astro.params;
if (!id) {
	return Astro.redirect("/");
}

const entry = await getEntry("posts", id);
if (!entry) {
	return new Response(null, { status: 404, statusText: "Not Found" });
}

const { title, body, draft, cover, author: authorRef } = entry.data;
const author = await getEntry(authorRef);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body>
		<p><a href="/">← home</a> · <a href="/cms">cms</a></p>
		<article>
			<header>
				<h1>{title}</h1>
				{draft ? (
					<p>
						<small>draft</small>
					</p>
				) : null}
				{author ? (
					<p>
						<small>author: {author.data.name}</small>
					</p>
				) : null}
			</header>

			{cover ? (
				<figure>
					<Image src={cover} alt="" />
				</figure>
			) : null}

			{body ? (
				<section>
					<pre>{body}</pre>
				</section>
			) : null}
		</article>
	</body>
</html>
