{
	"name": "astro-dev-cms",
	"private": true,
	"description": "PROTOTYPE monorepo — authoring shell tracer bullets",
	"packageManager": "bun@1.3.12",
	"workspaces": [
		"packages/fields",
		"packages/components",
		"packages/form",
		"packages/crud",
		"packages/routes",
		"packages/astro-template"
	],
	"scripts": {
		"dev": "bun run --filter @cms/astro-template dev",
		"build": "bun run --filter @cms/astro-template build",
		"check:allowlist": "bun run packages/astro-template/scripts/check-allowlist.ts",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0"
	}
}
