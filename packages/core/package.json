{
	"name": "@cms/core",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "CMS protocol + FS write-back adapters + schema→form projection",
	"exports": {
		".": "./src/index.ts",
		"./define-cms": "./src/define-cms.ts",
		"./fetch-client": "./src/fetch-client.ts",
		"./form-tree": "./src/form-tree.ts",
		"./http": "./src/http/index.ts",
		"./protocol": "./src/protocol.ts",
		"./semantic": "./src/semantic/index.ts"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"typescript": "catalog:"
	},
	"scripts": {
		"check": "tsc -p . && bunx tsc -p ./scripts/tsconfig.fixtures.json",
		"check:allowlist": "bun test src",
		"test:semantic": "bun test ./src/semantic ./src/form-tree.test.ts ./src/define-cms.test.ts",
		"test:http": "bun test ./src/http"
