{
	"name": "@cms/astro",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Astro host — cms() integration, /cms shell, /_cms protocol transport",
	"bin": {
		"cms": "./bin/cms.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./config": "./src/config.ts",
		"./content-proxy": "./src/content-proxy/index.ts",
		"./generate": "./src/generate/index.ts",
		"./testing": "./src/testing.ts",
		"./middleware-entry": "./src/middleware-entry.ts",
		"./shell-page.astro": "./src/shell-page.astro",
		"./CmsMount.svelte": "./src/CmsMount.svelte"
	},
	"dependencies": {
		"@cms/authoring": "workspace:*",
		"@cms/core": "workspace:*"
	},
	"peerDependencies": {
		"astro": "catalog:",
		"svelte": "catalog:"
	},
	"devDependencies": {
		"astro": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"zod": "catalog:"
	},
	"scripts": {
		"check": "tsc -p . && svelte-check --tsconfig ./tsconfig.json && bun test ./scripts/vite-virtuals.test.ts ./scripts/define-cms.test.ts ./scripts/emit-content-config.test.ts ./scripts/generate-content-config.test.ts ./scripts/content-config-generation-lifecycle.test.ts ./scripts/cms-happy-path.test.ts ./scripts/default-host.test.ts ./scripts/content-proxy.test.ts ./scripts/stamped-host.test.ts",
		"test:content-proxy": "bun test ./scripts/content-proxy.test.ts",
		"test:stamped-host": "bun test ./scripts/stamped-host.test.ts",
		"test:happy-path": "bun test ./scripts/cms-happy-path.test.ts"
	}
}
