---
/**
 * Package-owned authoring shell page.
 * Injected via @cms/astro cms() — not a project src/pages file.
 * Form models are projected on the Astro SSR graph (stamped content.config +
 * optional overlay); protocol transport stays on mount (/_cms).
 */
import CmsMount from "./CmsMount.svelte";
import { getPreviewUrl, loadShellFormModels } from "./shell-form-models";

const formModels = loadShellFormModels();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>CMS shell</title>
	</head>
	<body>
		<!-- client:only — sjsf templates break under Astro/Vite SSR -->
		<CmsMount client:only="svelte" formModels={formModels} {getPreviewUrl} />
	</body>
</html>
