---
/**
 * Real Astro site route for posts — default preview target (ADR-0013).
 * Renders persisted content via content collections + production block
 * renderer bindings (ADR-0012). No duplicate inline preview registry.
 */
import { getCollection, getEntry } from "astro:content";
import { resolveBlock } from "@cms/core";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { postBlocks } from "../../cms/post-blocks-render";
import CmsImage from "../../components/CmsImage.astro";

export async function getStaticPaths() {
	const posts = await getCollection("posts");
	return posts.map((post) => ({
		params: { id: post.id },
	}));
}

const { id } = Astro.params;
if (!id) {
	return Astro.redirect("/");
}

const entry = await getEntry("posts", id);
if (!entry) {
	return new Response(null, { status: 404, statusText: "Not Found" });
}

const data = entry.data as {
	title?: string;
	draft?: boolean;
	body?: string;
	summary?: { en?: string; it?: string };
	blocks?: Array<{ type: string; content: unknown }>;
	cover?: string | null;
	author?: string;
};

const blocks = Array.isArray(data.blocks) ? data.blocks : [];
const rendered = blocks.map((block) => {
	const resolved = resolveBlock(block, postBlocks);
	return {
		type: block.type,
		Comp: resolved?.component as AstroComponentFactory | undefined,
		props: (resolved?.props ?? {}) as Record<string, unknown>,
	};
});

const cover = typeof data.cover === "string" ? data.cover : null;
const title = typeof data.title === "string" ? data.title : id;
const summaryEn = data.summary?.en;
const summaryIt = data.summary?.it;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body>
		<p><a href="/">← home</a> · <a href="/cms">cms</a></p>
		<article>
			<header>
				<h1>{title}</h1>
				{data.draft ? (
					<p>
						<small>draft</small>
					</p>
				) : null}
				{data.author ? (
					<p>
						<small>author: {data.author}</small>
					</p>
				) : null}
			</header>

			{cover ? (
				<figure>
					<CmsImage src={cover} base="posts" alt="" />
				</figure>
			) : null}

			{data.body ? (
				<section>
					<pre>{data.body}</pre>
				</section>
			) : null}

			{summaryEn || summaryIt ? (
				<section>
					{summaryEn ? <p>{summaryEn}</p> : null}
					{summaryIt ? (
						<p>
							<small>{summaryIt}</small>
						</p>
					) : null}
				</section>
			) : null}

			{
				rendered.map((row) => {
					const Comp = row.Comp;
					return Comp ? (
						<Comp {...row.props} />
					) : (
						<p>
							<small>unknown block: {row.type}</small>
						</p>
					);
				})
			}
		</article>
	</body>
</html>
