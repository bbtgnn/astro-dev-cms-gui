---
/**
 * PROTOTYPE / SPIKE — Pass 3: Zod → JSON Schema → @cms/form (sjsf basic theme)
 */
import { prototypePostsSchema, toJsonSchema } from "@cms/fields";
import PlaceholderChrome from "../../../components/src/PlaceholderChrome.svelte";
import CmsForm from "../../../form/src/CmsForm.svelte";

const schema = toJsonSchema(prototypePostsSchema);
const value = {
	title: "Hello tracer",
	draft: true,
	body: "Pass 3 form spike value.",
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Form spike (prototype)</title>
	</head>
	<body>
		<p><a href="/">← home</a></p>
		<PlaceholderChrome label="@cms/components" />
		<!-- client:only — sjsf templates break under Astro/Vite SSR (Object.defineProperty) -->
		<CmsForm
			client:only="svelte"
			title="Posts form spike"
			schema={schema}
			value={value}
		/>
	</body>
</html>
