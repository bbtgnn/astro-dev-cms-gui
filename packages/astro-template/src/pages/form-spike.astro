---
/**
 * Form example — builders + FieldUi → JSON Schema / uiSchema → @cms/authoring.
 * Pass serializable schemas: live Zod meta does not survive Astro island props.
 */

import { CmsForm, PlaceholderChrome } from "@cms/authoring";
import { samplePostsSchema, toFormSchemas } from "@cms/core";

const { schema, uiSchema } = toFormSchemas(samplePostsSchema);
const value = {
	title: "Hello",
	draft: true,
	body: "Sample form value.",
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Form example</title>
	</head>
	<body>
		<p><a href="/">← home</a></p>
		<PlaceholderChrome label="@cms/authoring" />
		<!-- client:only — sjsf templates break under Astro/Vite SSR (Object.defineProperty) -->
		<CmsForm
			client:only="svelte"
			title="Posts form example"
			schema={schema}
			uiSchema={uiSchema}
			value={value}
		/>
	</body>
</html>
