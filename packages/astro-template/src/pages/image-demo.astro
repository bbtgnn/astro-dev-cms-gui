---
/**
 * PROTOTYPE — CmsImage srcset from authored cover folder beside posts/hello.
 */
import { existsSync, readFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { parse } from "yaml";
import CmsImage from "../components/CmsImage.astro";

type HelloDoc = {
	title?: string;
	cover?: string;
};

const yamlPath = join(
	dirname(fileURLToPath(import.meta.url)),
	"../../content-sandbox/posts/hello.yaml",
);
const doc = parse(readFileSync(yamlPath, "utf8")) as HelloDoc;
const cover = typeof doc.cover === "string" ? doc.cover : null;
const coverFs = cover
	? join(
			dirname(yamlPath),
			cover.replace(/^\.\//, ""),
		)
	: null;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>image render — {doc.title ?? "hello"}</title>
	</head>
	<body>
		<p><a href="/">← home</a></p>
		<h1>{doc.title}</h1>
		{
			cover && coverFs && existsSync(coverFs) ? (
				<figure>
					<CmsImage src={cover} base="posts" alt="Cover" />
					<figcaption><code>{cover}</code></figcaption>
				</figure>
			) : (
				<p>
					No cover yet — upload via <a href="/cms">/cms</a> posts/hello, then
					refresh.
				</p>
			)
		}
	</body>
</html>
