---
/**
 * Dev route: Astro mount for the reusable authoring application.
 * UI at /cms; JSON API remains middleware-mounted at /_cms.
 * Editor schemas + direct Svelte fields come from virtual:@cms/config (Vite),
 * wired in the client-only mount — not serialized through Astro frontmatter.
 */

import { PlaceholderChrome } from "@cms/components";
import CmsMount from "../components/CmsMount.svelte";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>CMS shell</title>
	</head>
	<body>
		<p><a href="/">← home</a></p>
		<PlaceholderChrome label="@cms/components" />
		<!-- client:only — sjsf templates break under Astro/Vite SSR -->
		<CmsMount client:only="svelte" />
	</body>
</html>
