{
  "workspace": [
    "./packages/fields",
    "./packages/components",
    "./packages/form",
    "./packages/crud",
    "./packages/routes",
    "./packages/astro-template"
  ],
  "nodeModulesDir": "auto",
  "tasks": {
    "install:template": "cd packages/astro-template && deno install --allow-scripts",
    "dev": "cd packages/astro-template && deno run -A npm:astro dev --host 127.0.0.1 --port 4321",
    "check:allowlist": "deno run -A packages/astro-template/scripts/check-allowlist.ts"
  }
}
